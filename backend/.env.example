ENVIRONMENT=development
PORT=8000
DEBUG=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# Google Gemini API — get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key

# Bhashini API — register at https://bhashini.gov.in → Udyat Portal
# Your Udyat API Key (from Udyat dashboard)
BHASHINI_API_KEY=your-udyat-api-key
# Your Inference Key (from Udyat → My Apps → Inference API Key)
BHASHINI_INFERENCE_KEY=your-inference-key
# Your User ID (from Udyat profile)
BHASHINI_USER_ID=your-user-id
